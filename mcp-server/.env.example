# --- Banco (Neon) ---
# String de conexão do Neon. Sem isso, o MCP roda só com DataJud/Comunica (não persiste).
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/gabinete?sslmode=require"

# --- DataJud (opcional) ---
# A chave pública oficial já vem embutida no código. Só defina se o CNJ rotacionar a chave.
# DATAJUD_API_KEY="cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw=="

# --- Coleta de intimações via navegador (Playwright) ---
# Diretório do perfil persistente do Chromium (mantém o aws-waf-token entre execuções).
# Default: %LOCALAPPDATA%/gabinete/comunica-profile
# COMUNICA_PROFILE_DIR=""

# --- Alerta de prazos (opcional) ---
# Se definido, scripts/alertar_prazos.mjs faz um POST JSON { text, prazos } para esta URL
# quando há prazos vencendo. Aponte para o seu canal (WhatsApp Business API, endpoint de
# e-mail, etc.). Sem a variável, o alerta apenas imprime no log do cron.
# ALERTA_WEBHOOK_URL=""

# --- Camada paga de documentos (Fase 2, opcional) ---
# JUDIT_API_KEY=""
# ESCAVADOR_API_KEY=""
